{
  "name": "vectorstoreweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:all": "npm test && npm run build && (npm run preview -- --host 127.0.0.1 > /tmp/vectorstore-vite-preview.log 2>&1 & preview_pid=$!; trap 'kill $preview_pid' EXIT; node scripts/integration-smoke.mjs)"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
